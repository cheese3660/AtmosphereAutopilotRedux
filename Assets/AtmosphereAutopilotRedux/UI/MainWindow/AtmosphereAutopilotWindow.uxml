<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/AtmosphereAutopilotRedux/UI/MainWindow/MainWindowStyles.uss?fileID=7433441132597879392&amp;guid=690b90a557da29041bc80f138c7fb63a&amp;type=3#MainWindowStyles"/>
    <UitkForKsp2.Controls.AppShell title="Atmosphere Autopilot" show-close-button="true">
        <ui:Label text="No Control" enabled="true" enable-rich-text="true" name="NoControl" style="display: none; -unity-text-align: upper-center; color: rgb(255, 0, 41); -unity-font-style: bold; font-size: 20px;"/>
        <ui:VisualElement name="Selectors" style="flex-grow: 1; flex-direction: row;">
            <UitkForKsp2.Controls.OabButton name="FBW" text="Fly By Wire" class="mode_button"/>
            <UitkForKsp2.Controls.OabButton name="Cruise" text="Cruise Control" class="mode_button"/>
        </ui:VisualElement>
        <ui:VisualElement name="SpeedControls" style="flex-grow: 1; display: none;">
            <ui:Label text="Speed Controls" class="section_header"/>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-self: auto; justify-content: space-evenly; align-items: center;">
                <ui:FloatField label="Speed (m/s)" value="100" name="SpeedInput" is-delayed="true" style="flex-grow: 1; -unity-text-align: middle-left;"/>
                <ui:Toggle label="" name="SpeedEnabled" class="switch"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CruiseControls" style="flex-grow: 1; display: none;">
            <ui:Label text="Cruise Controls" class="section_header"/>
            <ui:VisualElement class="selector_row">
                <ui:Label text="Course" class="selector_label"/>
                <UitkForKsp2.Controls.OabButton name="CourseHold" text="Hold" class="segment_button"/>
                <UitkForKsp2.Controls.OabButton name="CourseHeading" text="Heading" class="segment_button"/>
                <UitkForKsp2.Controls.OabButton name="CourseWaypoint" text="Waypoint" class="segment_button"/>
            </ui:VisualElement>
            <ui:VisualElement name="HeadingRow" class="field_row" style="display: none;">
                <ui:IntegerField label="Heading (°)" value="90" name="HeadingInput" is-delayed="true" style="-unity-text-align: middle-left; flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement name="WaypointRow" class="field_row" style="display: none;">
                <ui:DropdownField label="Waypoint" name="WaypointField" style="flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement class="spacer"/>
            <ui:VisualElement class="selector_row">
                <ui:Label text="Vertical" class="selector_label"/>
                <UitkForKsp2.Controls.OabButton name="VerticalOff" text="Off" class="segment_button"/>
                <UitkForKsp2.Controls.OabButton name="VerticalAltitude" text="Altitude" class="segment_button"/>
                <UitkForKsp2.Controls.OabButton name="VerticalSpeed" text="V/S" class="segment_button"/>
            </ui:VisualElement>
            <ui:VisualElement name="AltitudeRow" class="field_row" style="display: none;">
                <ui:IntegerField label="Altitude (m)" value="1000" name="AltitudeInput" is-delayed="true" style="-unity-text-align: middle-left; flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement name="VSRow" class="field_row" style="display: none;">
                <ui:IntegerField label="V. Speed (m/s)" value="0" name="VSInput" is-delayed="true" style="-unity-text-align: middle-left; flex-grow: 1;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </UitkForKsp2.Controls.AppShell>
</ui:UXML>
