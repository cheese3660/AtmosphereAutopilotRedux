<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/AtmosphereAutopilotRedux/UI/Mockup/MockupStyles.uss?fileID=7433441132597879392&amp;guid=92b84becf9414c7aa7266af0eaa52f36&amp;type=3#MockupStyles"/>
    <UitkForKsp2.Controls.AppShell title="Atmosphere Autopilot" show-close-button="true" class="root">
        <UitkForKsp2.Controls.InvertedCornerBox border-thickness="1" notch-size="5" border-color="#747680FF" background-color="#1B1E24FF" class="window-body oab-window-body">
            <ui:VisualElement class="engage_row">
                <UitkForKsp2.Controls.OabButton name="FBW" text="Fly By Wire" class="mode_button"/>
                <UitkForKsp2.Controls.OabButton name="Cruise" text="Cruise Control" class="mode_button active"/>
            </ui:VisualElement>
            <UitkForKsp2.Controls.InvertedCornerBox name="FMA" border-thickness="1" notch-size="5" border-color="#747680FF" background-color="#1B1E24FF" class="fma">
                <ui:VisualElement class="fma_cell">
                    <ui:Label text="SPEED" class="fma_active"/>
                    <ui:Label text="RETARD" class="fma_armed"/>
                </ui:VisualElement>
                <ui:VisualElement class="fma_cell">
                    <ui:Label text="LOC" class="fma_active"/>
                    <ui:Label text="ROLLOUT" class="fma_armed"/>
                </ui:VisualElement>
                <ui:VisualElement class="fma_cell fma_cell_last">
                    <ui:Label text="G/S" class="fma_active"/>
                    <ui:Label text="FLARE" class="fma_armed"/>
                </ui:VisualElement>
            </UitkForKsp2.Controls.InvertedCornerBox>
            <ui:VisualElement class="tab_row">
                <ui:Button name="TabCruise" text="CRUISE" class="tab"/>
                <ui:Button name="TabApproach" text="APPROACH" class="tab tab_active"/>
                <ui:Button name="TabTakeoff" text="TAKEOFF" class="tab"/>
            </ui:VisualElement>
            <ui:Label text="KSC 27R · 3.0° · 85 M/S" class="section-title"/>
            <UitkForKsp2.Controls.InvertedCornerBox border-thickness="1" notch-size="5" border-color="#747680FF" background-color="#1B1E24FF" class="deviation">
                <ui:VisualElement class="deviation_row">
                    <ui:Label text="LOC" class="deviation_label"/>
                    <ui:VisualElement class="deviation_scale">
                        <ui:VisualElement class="deviation_line"/>
                        <ui:VisualElement class="deviation_centre"/>
                        <ui:VisualElement class="deviation_marker" style="left: 44%;"/>
                    </ui:VisualElement>
                    <ui:Label text="6 m L" class="deviation_value"/>
                </ui:VisualElement>
                <ui:VisualElement class="deviation_row">
                    <ui:Label text="G/S" class="deviation_label"/>
                    <ui:VisualElement class="deviation_scale">
                        <ui:VisualElement class="deviation_line"/>
                        <ui:VisualElement class="deviation_centre"/>
                        <ui:VisualElement class="deviation_marker" style="left: 53%;"/>
                    </ui:VisualElement>
                    <ui:Label text="4 m hi" class="deviation_value"/>
                </ui:VisualElement>
            </UitkForKsp2.Controls.InvertedCornerBox>
            <UitkForKsp2.Controls.InvertedCornerBox border-thickness="1" notch-size="5" border-color="#747680FF" background-color="#1B1E24FF" class="readout">
                <ui:VisualElement class="readout_cell"><ui:Label text="Distance"/><ui:Label text="7.4 km" class="readout_value"/></ui:VisualElement>
                <ui:VisualElement class="readout_cell"><ui:Label text="Height"/><ui:Label text="402 m" class="readout_value"/></ui:VisualElement>
                <ui:VisualElement class="readout_cell"><ui:Label text="Speed"/><ui:Label text="85 m/s" class="readout_value"/></ui:VisualElement>
                <ui:VisualElement class="readout_cell"><ui:Label text="V/S"/><ui:Label text="-4.5 m/s" class="readout_value"/></ui:VisualElement>
            </UitkForKsp2.Controls.InvertedCornerBox>
            <ui:VisualElement class="action_row">
                <UitkForKsp2.Controls.OabButton text="GO AROUND" class="action-button action-button-wide"/>
                <UitkForKsp2.Controls.OabButton text="DISARM" class="action-button destructive"/>
            </ui:VisualElement>
        </UitkForKsp2.Controls.InvertedCornerBox>
    </UitkForKsp2.Controls.AppShell>
</ui:UXML>
