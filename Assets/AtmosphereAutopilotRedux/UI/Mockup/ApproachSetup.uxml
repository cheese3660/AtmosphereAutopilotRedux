<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/AtmosphereAutopilotRedux/UI/Mockup/MockupStyles.uss?fileID=7433441132597879392&amp;guid=92b84becf9414c7aa7266af0eaa52f36&amp;type=3#MockupStyles"/>
    <UitkForKsp2.Controls.AppShell title="Atmosphere Autopilot" show-close-button="true" class="root">
        <UitkForKsp2.Controls.InvertedCornerBox border-thickness="1" notch-size="5" border-color="#747680FF" background-color="#1B1E24FF" class="window-body oab-window-body">
            <ui:VisualElement class="engage_row">
                <UitkForKsp2.Controls.OabButton name="FBW" text="Fly By Wire" class="mode_button"/>
                <UitkForKsp2.Controls.OabButton name="Cruise" text="Cruise Control" class="mode_button active"/>
            </ui:VisualElement>
            <UitkForKsp2.Controls.InvertedCornerBox name="FMA" border-thickness="1" notch-size="5" border-color="#747680FF" background-color="#1B1E24FF" class="fma">
                <ui:VisualElement class="fma_cell">
                    <ui:Label text="SPEED" class="fma_active"/>
                    <ui:Label text="-" class="fma_armed fma_none"/>
                </ui:VisualElement>
                <ui:VisualElement class="fma_cell">
                    <ui:Label text="HDG" class="fma_active"/>
                    <ui:Label text="-" class="fma_armed fma_none"/>
                </ui:VisualElement>
                <ui:VisualElement class="fma_cell fma_cell_last">
                    <ui:Label text="ALT" class="fma_active"/>
                    <ui:Label text="-" class="fma_armed fma_none"/>
                </ui:VisualElement>
            </UitkForKsp2.Controls.InvertedCornerBox>
            <ui:VisualElement class="tab_row">
                <ui:Button name="TabCruise" text="CRUISE" class="tab"/>
                <ui:Button name="TabApproach" text="APPROACH" class="tab tab_active"/>
                <ui:Button name="TabTakeoff" text="TAKEOFF" class="tab"/>
            </ui:VisualElement>
            <ui:VisualElement class="field_row"><ui:DropdownField label="Airport" name="Airport" choices="KSC,Island Airfield" index="0" class="field"/></ui:VisualElement>
            <ui:VisualElement class="selector_row">
                <ui:Label text="Runway" class="selector_label"/>
                <UitkForKsp2.Controls.OabButton name="Seg09L" text="09L" class="segment_button"/>
                <UitkForKsp2.Controls.OabButton name="Seg27R" text="27R" class="segment_button active"/>
                <UitkForKsp2.Controls.OabButton name="Seg09R" text="09R" class="segment_button"/>
                <UitkForKsp2.Controls.OabButton name="Seg27L" text="27L" class="segment_button"/>
            </ui:VisualElement>
            <UitkForKsp2.Controls.InvertedCornerBox border-thickness="1" notch-size="5" border-color="#747680FF" background-color="#1B1E24FF" class="readout">
                <ui:VisualElement class="readout_cell"><ui:Label text="Length"/><ui:Label text="6826 m" class="readout_value"/></ui:VisualElement>
                <ui:VisualElement class="readout_cell"><ui:Label text="Course"/><ui:Label text="270°" class="readout_value"/></ui:VisualElement>
                <ui:VisualElement class="readout_cell"><ui:Label text="Distance"/><ui:Label text="48.2 km" class="readout_value"/></ui:VisualElement>
                <ui:VisualElement class="readout_cell"><ui:Label text="Elev."/><ui:Label text="98 m" class="readout_value"/></ui:VisualElement>
            </UitkForKsp2.Controls.InvertedCornerBox>
            <ui:VisualElement class="field_row"><ui:FloatField label="G/S (°)" value="3" name="GlideslopeInput" is-delayed="true" class="field"/></ui:VisualElement>
            <ui:VisualElement class="field_row"><ui:FloatField label="Speed (m/s)" value="85" name="ApproachSpeedInput" is-delayed="true" class="field"/></ui:VisualElement>
            <ui:VisualElement class="field_row"><ui:IntegerField label="Minimums (m)" value="60" name="MinimumsInput" is-delayed="true" class="field"/></ui:VisualElement>
            <ui:Toggle label="Autoland" name="Autoland" value="true" class="switch toggle_field"/>
            <UitkForKsp2.Controls.InvertedCornerBox border-thickness="1" notch-size="5" border-color="#747680FF" background-color="#1B1E24FF" class="readout">
                <ui:VisualElement class="readout_cell readout_cell_full"><ui:Label text="Go-around"/><ui:Label text="500 m · 120 m/s" class="readout_value"/></ui:VisualElement>
            </UitkForKsp2.Controls.InvertedCornerBox>
            <ui:VisualElement class="action_row">
                <UitkForKsp2.Controls.OabButton text="ARM APPROACH" class="action-button"/>
            </ui:VisualElement>
        </UitkForKsp2.Controls.InvertedCornerBox>
    </UitkForKsp2.Controls.AppShell>
</ui:UXML>
